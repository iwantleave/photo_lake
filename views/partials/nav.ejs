<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= typeof title!=='undefined' ? title : 'Photo World' %></title>
<link rel="stylesheet" href="/styles.css?v=<%= assetVersion %>">
<script src="/vendor/htmx/htmx.min.js"></script>
<script src="/vendor/alpine/cdn.min.js" defer></script>
</head>
<body>
<div class="app">
  <aside class="sidebar">
    <div class="brand"><span class="logo">📷</span> Photo World</div>
    <div class="nav-group-label">管理</div>
    <nav class="nav">
      <a href="/" class="<%= active==='home'?'active':'' %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
        概览</a>
      <a href="/folders" class="<%= active==='folders'?'active':'' %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
        文件夹</a>
      <a href="/media" class="<%= active==='media'?'active':'' %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="m3 16 5-5 4 4 3-3 6 6"/></svg>
        媒体</a>
      <a href="/media/duplicates" class="<%= active==='dup'?'active':'' %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="4" width="13" height="13" rx="2"/><path d="M8 8h11a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H10a2 2 0 0 1-2-2z"/></svg>
        重复</a>
      <a href="/map" class="<%= active==='map'?'active':'' %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 4 3 6v14l6-2 6 2 6-2V4l-6 2-6-2z"/><path d="M9 4v14M15 6v14"/></svg>
        地图</a>
      <a href="/jobs" class="<%= active==='jobs'?'active':'' %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v4h4"/></svg>
        任务</a>
    </nav>
    <div x-data="{ open:true, tree:[], expanded:{}, async load(){ try{ const r=await fetch('/api/topics-tree'); const d=await r.json(); this.tree=d.tree||[]; }catch(e){ this.tree=[]; } }, toggle(y){ this.expanded[y]=!this.expanded[y]; } }" x-init="load()">
      <div class="nav-group-label clickable" @click="open=!open">
        <span>主题</span><span class="caret" x-text="open ? '▾' : '▸'"></span>
      </div>
      <div class="topic-tree" x-show="open" x-cloak>
        <template x-for="grp in tree" :key="grp.year">
          <div class="topic-group">
            <div class="topic-year" @click.stop="toggle(grp.year)" :class="{collapsed:!expanded[grp.year]}">
              <span class="caret" x-text="expanded[grp.year] ? '▾' : '▸'"></span>
              <span class="ty" x-text="grp.year"></span>
              <span class="tc" x-text="grp.folders.length"></span>
            </div>
            <div class="topic-leaves" x-show="expanded[grp.year]">
              <template x-for="f in grp.folders" :key="f.id">
                <a class="topic-leaf" :href="'/media?folder_ids=' + f.id" :title="f.alias || f.topic">
                  <span class="tl-name" x-text="f.topic"></span>
                </a>
              </template>
            </div>
          </div>
        </template>
        <div class="topic-empty" x-show="tree.length === 0">暂无主题</div>
      </div>
    </div>
    <div class="nav-group-label">系统</div>
    <nav class="nav">
      <a href="/settings" class="<%= active==='settings'?'active':'' %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.6 1.6 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.6 1.6 0 0 0-2.7 1.1V21a2 2 0 1 1-4 0v-.1A1.6 1.6 0 0 0 7 19.4a1.6 1.6 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.6 1.6 0 0 0-1.1-2.7H1a2 2 0 1 1 0-4h.1A1.6 1.6 0 0 0 2.6 7a1.6 1.6 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1A1.6 1.6 0 0 0 7 2.6h.1A1.6 1.6 0 0 0 8 1.1V1a2 2 0 1 1 4 0v.1A1.6 1.6 0 0 0 15 2.6a1.6 1.6 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.6 1.6 0 0 0-.3 1.8V7a1.6 1.6 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.6 1.6 0 0 0-1.5 1z"/></svg>
        设置</a>
    </nav>
    <div class="spacer"></div>
    <div class="foot">v1.3 · 本地数据库<br>扫描引擎就绪</div>
  </aside>
  <div class="main">
